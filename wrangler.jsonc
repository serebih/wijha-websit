{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wijha-websit",
  "compatibility_date": "2026-05-21",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  // Le site répond sur le domaine nu et sur www.
  "routes": [
    { "pattern": "wijha-eng.com", "custom_domain": true },
    { "pattern": "www.wijha-eng.com", "custom_domain": true }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
